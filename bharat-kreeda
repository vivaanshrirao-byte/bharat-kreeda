        window.addEventListener('DOMContentLoaded', () => {
            renderGamesLibrary();
            announceToScreenReader("Bharat Krida Multiplayer App loaded with 40 Indian Board Games. Select a game to play.");
        });

        function renderGamesLibrary() {
            const grid = document.getElementById('gamesGrid');
            grid.innerHTML = '';

            const filtered = INDIAN_GAMES_DATABASE.filter(g => {
                const matchCat = (currentFilterCategory === 'all') || (g.category === currentFilterCategory);
                const matchSearch = g.name.toLowerCase().includes(searchQuery.toLowerCase()) || 
                                    g.region.toLowerCase().includes(searchQuery.toLowerCase());
                return matchCat && matchSearch;
            });

            filtered.forEach(game => {
                const card = document.createElement('div');
                card.className = "rounded-2xl bg-slate-900 border border-slate-800 hover:border-amber-500/50 p-4 flex flex-col justify-between cursor-pointer transition shadow-lg";
                card.setAttribute('role', 'button');
                card.setAttribute('tabindex', '0');
                card.setAttribute('aria-label', `${game.name}, ${game.category}, ${game.region}`);
                
                card.onclick = () => selectAndLoadGame(game.id);
                card.onkeydown = (e) => { if (e.key === 'Enter' || e.key === ' ') selectAndLoadGame(game.id); };

                card.innerHTML = `
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-amber-400 border border-slate-700">${game.category}</span>
                            <span class="text-[11px] text-slate-400"><i class="fa-solid fa-users text-amber-500"></i> ${game.players}</span>
                        </div>
                        <h3 class="heading-font text-base font-bold text-slate-100 mb-0.5">${game.name}</h3>
                        <p class="text-xs text-amber-500 font-medium mb-2">${game.nativeName} • ${game.region}</p>
                        <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed mb-3">${game.desc}</p>
                    </div>
                    <div class="pt-2 border-t border-slate-800 flex items-center justify-between">
                        <span class="text-[10px] text-slate-400 font-bold"><i class="fa-solid fa-brain text-amber-400"></i> ${game.difficulty}</span>
                        <span class="text-xs font-bold text-amber-400 flex items-center gap-1">Play <i class="fa-solid fa-chevron-right text-[10px]"></i></span>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function setCategoryFilter(cat) {
            currentFilterCategory = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => btn.className = "cat-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-900 text-slate-400 border border-slate-800");
            const map = { 'all': 'cat-all', 'Hunt & Capture': 'cat-hunt', 'Race & Cross': 'cat-race', 'Mancala & Pit': 'cat-mancala', 'Alignment & Grid': 'cat-alignment' };
            if (document.getElementById(map[cat])) document.getElementById(map[cat]).className = "cat-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-amber-500 text-slate-950";
            renderGamesLibrary();
        }

        function filterGames() {
            searchQuery = document.getElementById('searchInput').value;
            renderGamesLibrary();
        }

        function switchView(view) {
            playSyntheticSound('click');
            document.getElementById('libraryView').classList.toggle('hidden', view !== 'library');
            document.getElementById('gamePlayView').classList.toggle('hidden', view !== 'gameplay');
        }

        function selectAndLoadGame(id) {
            currentGame = INDIAN_GAMES_DATABASE.find(g => g.id === id);
            if (!currentGame) return;

            document.getElementById('activeGameTitle').innerText = currentGame.name;
            document.getElementById('activeGameCategory').innerText = currentGame.category;
            document.getElementById('activeGameOrigin').innerText = `${currentGame.nativeName} (${currentGame.region})`;
            document.getElementById('activeGameRules').innerText = currentGame.rules;

            gameState.status = 'not_started';
            gameState.turn = 'p1';
            gameState.p1Score = 0;
            gameState.p2Score = 0;

            setupInteractiveBoard(currentGame);
            updateUIState();
            switchView('gameplay');
            announceToScreenReader(`Selected ${currentGame.name}. ${currentGame.rules}`);
        }

        function updateUIState() {
            document.getElementById('turnIndicator').innerText = gameState.turn === 'p1' ? 'Player 1' : 'Player 2 / AI';
            document.getElementById('scoreBoard').innerText = `P1: ${gameState.p1Score} | P2: ${gameState.p2Score}`;
            document.getElementById('primaryBtnText').innerText = gameState.status === 'playing' ? 'In Progress' : 'Start Match';
        }

        function changeGameMode(mode) {
            gameState.mode = mode;
            document.getElementById('onlineRoomBox').classList.toggle('hidden', mode !== 'pvp-online');
            setGameStatus(`Mode set to: ${mode}`);
        }

        async function createOnlineRoom() {
            if (!window.fbDb || !window.currentUser) {
                alert("Connecting to server... Please try again in 2 seconds.");
                return;
            }
            const roomCode = Math.random().toString(36).substring(2, 8).toUpperCase();
            const { doc, setDoc, onSnapshot } = window.fbMethods;
            
            activeRoomId = roomCode;
            document.getElementById('roomCodeDisplay').innerText = roomCode;
            document.getElementById('connectionStatus').innerText = "Status: Room Created. Share code!";

            const roomRef = doc(window.fbDb, 'artifacts', window.fbAppId, 'public', 'data', 'rooms', roomCode);
            await setDoc(roomRef, {
                gameId: currentGame.id,
                host: window.currentUser.uid,
                guest: null,
                gameState: gameState,
                createdAt: Date.now()
            });

            if (roomUnsubscribe) roomUnsubscribe();
            roomUnsubscribe = onSnapshot(roomRef, (snapshot) => {
                if (snapshot.exists()) {
                    const data = snapshot.data();
                    if (data.guest && document.getElementById('connectionStatus').innerText.includes("Share")) {
                        document.getElementById('connectionStatus').innerText = "Status: Player 2 Connected!";
                        announceToScreenReader("Guest connected to your room!");
                    }
                    if (data.gameState && JSON.stringify(data.gameState) !== JSON.stringify(gameState)) {
                        gameState = data.gameState;
                        updateUIState();
                        syncBoardUI();
                    }
                }
            });

            subscribeToChat(roomCode);
            announceToScreenReader(`Room created with code ${roomCode}. Share code with opponent.`);
        }

        async function joinOnlineRoomPrompt() {
            const code = prompt("Enter 6-digit Room Invite Code:")?.trim().toUpperCase();
            if (!code) return;

            const { doc, getDoc, updateDoc, onSnapshot } = window.fbMethods;
            const roomRef = doc(window.fbDb, 'artifacts', window.fbAppId, 'public', 'data', 'rooms', code);
            const snap = await getDoc(roomRef);

            if (snap.exists()) {
                activeRoomId = code;
                document.getElementById('roomCodeDisplay').innerText = code;
                document.getElementById('connectionStatus').innerText = "Status: Joined Room!";

                await updateDoc(roomRef, { guest: window.currentUser.uid });

                if (roomUnsubscribe) roomUnsubscribe();
                roomUnsubscribe = onSnapshot(roomRef, (s) => {
                    if (s.exists()) {
                        const data = s.data();
                        if (data.gameState) {
                            gameState = data.gameState;
                            updateUIState();
                            syncBoardUI();
                        }
                    }
                });

                subscribeToChat(code);
                announceToScreenReader(`Successfully joined room ${code}`);
            } else {
                alert("Room code not found!");
            }
        }

        function subscribeToChat(roomCode) {
            const { collection, onSnapshot } = window.fbMethods;
            const chatRef = collection(window.fbDb, 'artifacts', window.fbAppId, 'public', 'data', 'rooms', roomCode, 'chat');
            
            if (chatUnsubscribe) chatUnsubscribe();
            chatUnsubscribe = onSnapshot(chatRef, (snapshot) => {
                const log = document.getElementById('chatMessageLog');
                log.innerHTML = '';
                snapshot.docs.forEach(docSnap => {
                    const d = docSnap.data();
                    const msgDiv = document.createElement('div');
                    msgDiv.className = "py-0.5 border-b border-slate-800/40 text-[11px]";
                    msgDiv.innerHTML = `<span class="font-bold text-amber-400">${d.sender}:</span> <span class="text-slate-200">${d.text}</span>`;
                    log.appendChild(msgDiv);
                });
                log.scrollTop = log.scrollHeight;
            });
        }

        async function sendChatMessage() {
            const input = document.getElementById('chatInput');
            const msg = input.value.trim();
            if (!msg || !activeRoomId) return;

            const { collection, addDoc } = window.fbMethods;
            const chatRef = collection(window.fbDb, 'artifacts', window.fbAppId, 'public', 'data', 'rooms', activeRoomId, 'chat');
            
            await addDoc(chatRef, {
                sender: window.currentUser.uid.substring(0, 5),
                text: msg,
                time: Date.now()
            });

            input.value = '';
            playSyntheticSound('click');
        }

        function toggleMicChannel() {
            isMicOn = !isMicOn;
            const waveBar = document.getElementById('voiceWaveBar');
            const label = document.getElementById('micLabel');
            const icon = document.getElementById('micIcon');

            if (isMicOn) {
                waveBar.classList.remove('hidden');
                label.innerText = "Voice ON";
                icon.className = "fa-solid fa-microphone text-emerald-400";
                announceToScreenReader("HD Spatial Audio Voice Channel Connected");
            } else {
                waveBar.classList.add('hidden');
                label.innerText = "HD Voice Off";
                icon.className = "fa-solid fa-microphone-slash text-rose-400";
                announceToScreenReader("Voice Channel Muted");
            }
        }

        function handlePrimaryAction() {
            gameState.status = 'playing';
            gameState.turn = 'p1';
            playSyntheticSound('win');
            setGameStatus("Match started! Player 1's Turn.");
            setupInteractiveBoard(currentGame);
            updateUIState();
            syncStateToFirebase();
        }

        function resetCurrentGame() {
            gameState.status = 'not_started';
            gameState.p1Score = 0;
            gameState.p2Score = 0;
            setGameStatus("Match board reset.");
            setupInteractiveBoard(currentGame);
            updateUIState();
            syncStateToFirebase();
        }

        function setGameStatus(msg) {
            document.getElementById('gameStatusText').innerText = msg;
            announceToScreenReader(msg);
        }

        async function syncStateToFirebase() {
            if (activeRoomId && gameState.mode === 'pvp-online') {
                const { doc, updateDoc } = window.fbMethods;
                const roomRef = doc(window.fbDb, 'artifacts', window.fbAppId, 'public', 'data', 'rooms', activeRoomId);
                await updateDoc(roomRef, { gameState: gameState });
            }
        }

        function setupInteractiveBoard(game) {
            const container = document.getElementById('gameBoardContainer');
            const diceArea = document.getElementById('diceControlArea');
            container.innerHTML = '';
            diceArea.classList.add('hidden');

            if (game.category === 'Hunt & Capture') renderHuntCaptureBoard(container);
            else if (game.category === 'Mancala & Pit') renderMancalaBoard(container);
            else if (game.category === 'Race & Cross') { diceArea.classList.remove('hidden'); renderRaceCrossBoard(container); }
            else renderAlignmentGridBoard(container);
        }

        function syncBoardUI() {
            if (!currentGame) return;
            const container = document.getElementById('gameBoardContainer');
            if (currentGame.category === 'Hunt & Capture') renderHuntGridNodes(container.firstChild);
            else if (currentGame.category === 'Race & Cross') updateRacePositions();
        }

        function renderHuntCaptureBoard(container) {
            const boardGrid = document.createElement('div');
            boardGrid.className = "w-full h-full grid grid-cols-5 gap-2 p-2 bg-amber-950/40 rounded-xl border border-amber-600/30";
            gameState.boardData = Array(25).fill(null);
            gameState.boardData[0] = 'P2'; gameState.boardData[2] = 'P2'; gameState.boardData[4] = 'P2';
            renderHuntGridNodes(boardGrid);
            container.appendChild(boardGrid);
        }

        function renderHuntGridNodes(container) {
            if (!container) return;
            container.innerHTML = '';
            gameState.boardData.forEach((cell, idx) => {
                const node = document.createElement('button');
                node.className = "relative rounded-full flex items-center justify-center border border-slate-700 bg-slate-900 hover:border-amber-500 transition shadow-inner";
                node.setAttribute('aria-label', `Space ${idx + 1}, ${cell ? cell : 'empty'}`);
                
                if (cell === 'P1') node.innerHTML = `<div class="w-7 h-7 rounded-full bg-amber-400 text-slate-950 font-extrabold text-xs flex items-center justify-center">G</div>`;
                else if (cell === 'P2') node.innerHTML = `<div class="w-7 h-7 rounded-full bg-rose-600 text-white font-extrabold text-xs flex items-center justify-center">T</div>`;

                node.onclick = () => handleHuntClick(idx);
                container.appendChild(node);
            });
        }

        function handleHuntClick(idx) {
            if (gameState.status !== 'playing' || gameState.boardData[idx] !== null) return;
            playSyntheticSound('click');
            
            gameState.boardData[idx] = gameState.turn === 'p1' ? 'P1' : 'P2';
            gameState.turn = gameState.turn === 'p1' ? 'p2' : 'p1';
            setGameStatus(`Placed piece at space ${idx + 1}.`);
            
            updateUIState();
            renderHuntGridNodes(document.getElementById('gameBoardContainer').firstChild);
            syncStateToFirebase();

            if (gameState.turn === 'p2' && gameState.mode.startsWith('ai')) setTimeout(triggerAITurn, 600);
        }

        function renderMancalaBoard(container) {
            const wrapper = document.createElement('div');
            wrapper.className = "w-full flex flex-col justify-between gap-6 p-4 bg-amber-950/30 rounded-2xl border border-amber-600/30";
            gameState.boardData = { row1: [5,5,5,5,5,5,5], row2: [5,5,5,5,5,5,5] };

            ['row2', 'row1'].forEach(row => {
                const rDiv = document.createElement('div');
                rDiv.className = "grid grid-cols-7 gap-2";
                gameState.boardData[row].forEach((seeds, idx) => {
                    const pit = document.createElement('button');
                    pit.className = "h-16 rounded-xl bg-slate-950 border border-amber-600/40 flex flex-col items-center justify-center text-xs font-bold text-amber-400";
                    pit.innerText = `${seeds} Seeds`;
                    pit.onclick = () => handleMancalaClick(row, idx);
                    rDiv.appendChild(pit);
                });
                wrapper.appendChild(rDiv);
            });
            container.appendChild(wrapper);
        }

        function handleMancalaClick(row, idx) {
            if (gameState.status !== 'playing' || gameState.boardData[row][idx] === 0) return;
            playSyntheticSound('capture');
            const seeds = gameState.boardData[row][idx];
            gameState.boardData[row][idx] = 0;
            
            if (gameState.turn === 'p1') gameState.p1Score += seeds;
            else gameState.p2Score += seeds;

            gameState.turn = gameState.turn === 'p1' ? 'p2' : 'p1';
            setGameStatus(`Sowed ${seeds} seeds. Next turn.`);
            updateUIState();
            renderMancalaBoard(document.getElementById('gameBoardContainer'));
