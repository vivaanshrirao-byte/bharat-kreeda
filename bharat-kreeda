        let currentFilterCategory = 'all';
        let searchQuery = '';
        let currentGame = null;
        let activeRoomId = null;
        let roomUnsubscribe = null;
        let chatUnsubscribe = null;
        let isMicOn = false;

        let gameState = {
            status: 'not_started',
            turn: 'p1',
            mode: 'ai-easy',
            p1Score: 0,
